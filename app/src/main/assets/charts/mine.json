  "lyrics": [
    {
      "startSec": 0.43,
      "endSec": 8.662,
      "text": "Oh, oh-oh, oh-oh",
      "soft": true
    },
    {
      "startSec": 8.662,
      "endSec": 17.688,
      "text": "Oh, oh-oh, oh-oh",
      "soft": true
    },
    {
      "startSec": 17.688,
      "endSec": 21.655,
      "text": "You were in college working part-time, waitin’ tables"
    },
    {
      "startSec": 21.655,
      "endSec": 25.622,
      "text": "Left a small town, never looked back"
    },
    {
      "startSec": 25.622,
      "endSec": 29.59,
      "text": "I was a flight risk with a fear of falling"
    },
    {
      "startSec": 29.59,
      "endSec": 33.557,
      "text": "Wonderin’ why we bother with love if it never lasts"
    },
    {
      "startSec": 33.557,
      "endSec": 37.524,
      "text": "I say, “Can you believe it?”"
    },
    {
      "startSec": 37.524,
      "endSec": 41.492,
      "text": "As we’re lying on the couch"
    },
    {
      "startSec": 41.492,
      "endSec": 45.459,
      "text": "The moment I could see it"
    },
    {
      "startSec": 45.459,
      "endSec": 49.426,
      "text": "Yes, yes, I can see it now"
    },
    {
      "startSec": 49.426,
      "endSec": 53.393,
      "text": "Do you remember we were sitting there by the water?"
    },
    {
      "startSec": 53.393,
      "endSec": 57.361,
      "text": "You put your arm around me for the first time"
    },
    {
      "startSec": 57.361,
      "endSec": 61.328,
      "text": "You made a rebel of a careless man’s careful daughter"
    },
    {
      "startSec": 61.328,
      "endSec": 67.279,
      "text": "You are the best thing that’s ever been mine"
    },
    {
      "startSec": 69.263,
      "endSec": 73.23,
      "text": "Flash forward and we’re taking on the world together"
    },
    {
      "startSec": 73.23,
      "endSec": 77.197,
      "text": "And there’s a drawer of my things at your place"
    },
    {
      "startSec": 77.197,
      "endSec": 81.165,
      "text": "You learned my secrets and you figure out why I’m guarded"
    },
    {
      "startSec": 81.165,
      "endSec": 85.132,
      "text": "You say we’ll never make my parents’ mistakes"
    },
    {
      "startSec": 85.132,
      "endSec": 89.099,
      "text": "But we got bills to pay"
    },
    {
      "startSec": 89.099,
      "endSec": 93.067,
      "text": "We got nothing figured out"
    },
    {
      "startSec": 93.067,
      "endSec": 97.034,
      "text": "When it was hard to take"
    },
    {
      "startSec": 97.034,
      "endSec": 101.001,
      "text": "Yes, yes, this is what I thought about"
    },
    {
      "startSec": 101.001,
      "endSec": 104.968,
      "text": "Do you remember we were sitting there by the water?"
    },
    {
      "startSec": 104.968,
      "endSec": 108.936,
      "text": "You put your arm around me for the first time"
    },
    {
      "startSec": 108.936,
      "endSec": 112.903,
      "text": "You made a rebel of a careless man’s careful daughter"
    },
    {
      "startSec": 112.903,
      "endSec": 116.87,
      "text": "You are the best thing that’s ever been mine"
    },
    {
      "startSec": 116.87,
      "endSec": 120.838,
      "text": "Do you remember all the city lights on the water?"
    },
    {
      "startSec": 120.838,
      "endSec": 124.805,
      "text": "You saw me start to believe for the first time"
    },
    {
      "startSec": 124.805,
      "endSec": 128.772,
      "text": "You made a rebel of a careless man’s careful daughter"
    },
    {
      "startSec": 128.772,
      "endSec": 132.74,
      "text": "You are the best thing that’s ever been mine"
    },
    {
      "startSec": 132.74,
      "endSec": 140.674,
      "text": "Oh, oh-oh, oh-oh",
      "soft": true
    },
    {
      "startSec": 140.674,
      "endSec": 144.641,
      "text": "And I remember that fight, 2:30 AM"
    },
    {
      "startSec": 144.641,
      "endSec": 148.609,
      "text": "’Cause everything was slipping right out of our hands"
    },
    {
      "startSec": 148.609,
      "endSec": 156.543,
      "text": "I ran out crying and you followed me out into the street"
    },
    {
      "startSec": 156.543,
      "endSec": 160.511,
      "text": "Brace myself for the goodbye"
    },
    {
      "startSec": 160.511,
      "endSec": 164.478,
      "text": "’Cause that’s all I’ve ever known"
    },
    {
      "startSec": 164.478,
      "endSec": 168.445,
      "text": "And you took me by surprise"
    },
    {
      "startSec": 168.445,
      "endSec": 176.38,
      "text": "You said, “I’ll never leave you alone”"
    },
    {
      "startSec": 176.38,
      "endSec": 180.347,
      "text": "You said, “I remember how we felt sittin’ by the water"
    },
    {
      "startSec": 180.347,
      "endSec": 184.314,
      "text": "And every time I look at you, it’s like the first time"
    },
    {
      "startSec": 184.314,
      "endSec": 188.282,
      "text": "I fell in love with a careless man’s careful daughter"
    },
    {
      "startSec": 188.282,
      "endSec": 192.249,
      "text": "She is the best thing that’s ever been mine”"
    },
    {
      "startSec": 192.249,
      "endSec": 196.216,
      "text": "Hold on, make it last"
    },
    {
      "startSec": 196.216,
      "endSec": 200.184,
      "text": "Hold on, never turn back"
    },
    {
      "startSec": 200.184,
      "endSec": 204.151,
      "text": "You made a rebel of a careless man’s careful daughter"
    },
    {
      "startSec": 204.151,
      "endSec": 208.118,
      "text": "You are the best thing that’s ever been mine"
    },
    {
      "startSec": 208.118,
      "endSec": 212.086,
      "text": "Yeah, yeah — Do you believe it? Hold on"
    },
    {
      "startSec": 212.086,
      "endSec": 216.053,
      "text": "We’re gonna make it now (Hold on)"
    },
    {
      "startSec": 216.053,
      "endSec": 220.02,
      "text": "Yeah, yeah, hey — And I can see it"
    },
    {
      "startSec": 220.02,
      "endSec": 225.971,
      "text": "And I can see it now, see it now, see it now"
    }
  ]
}