  "lyrics": [
    {
      "startSec": 0.167,
      "endSec": 3.947,
      "text": "Acoustic Intro",
      "soft": true
    },
    {
      "startSec": 3.947,
      "endSec": 7.726,
      "text": "I’ve tried playing it cool"
    },
    {
      "startSec": 7.726,
      "endSec": 11.506,
      "text": "But when I’m looking at you"
    },
    {
      "startSec": 11.506,
      "endSec": 15.286,
      "text": "I can’t ever be brave"
    },
    {
      "startSec": 15.286,
      "endSec": 19.065,
      "text": "’Cause you make my heart race"
    },
    {
      "startSec": 19.065,
      "endSec": 22.845,
      "text": "Shot me out of the sky"
    },
    {
      "startSec": 22.845,
      "endSec": 26.624,
      "text": "You’re my Kryptonite"
    },
    {
      "startSec": 26.624,
      "endSec": 30.404,
      "text": "You keep making me weak"
    },
    {
      "startSec": 30.404,
      "endSec": 34.184,
      "text": "Yeah, frozen and can’t breathe"
    },
    {
      "startSec": 34.184,
      "endSec": 37.963,
      "text": "Something’s gotta give now"
    },
    {
      "startSec": 37.963,
      "endSec": 41.743,
      "text": "’Cause I’m dying just to make you see"
    },
    {
      "startSec": 41.743,
      "endSec": 45.522,
      "text": "That I need you here with me now"
    },
    {
      "startSec": 45.522,
      "endSec": 49.302,
      "text": "’Cause you’ve got that one thing"
    },
    {
      "startSec": 49.302,
      "endSec": 53.082,
      "text": "So get out, get out, get out of my head"
    },
    {
      "startSec": 53.082,
      "endSec": 56.861,
      "text": "And fall into my arms instead"
    },
    {
      "startSec": 56.861,
      "endSec": 60.641,
      "text": "I don’t, I don’t, don’t know what it is"
    },
    {
      "startSec": 60.641,
      "endSec": 64.42,
      "text": "But I need that one thing"
    },
    {
      "startSec": 64.42,
      "endSec": 68.2,
      "text": "And you’ve got that one thing"
    },
    {
      "startSec": 71.979,
      "endSec": 75.759,
      "text": "Now I’m climbing the walls"
    },
    {
      "startSec": 75.759,
      "endSec": 79.539,
      "text": "But you don’t notice at all"
    },
    {
      "startSec": 79.539,
      "endSec": 83.318,
      "text": "That I’m going out of my mind"
    },
    {
      "startSec": 83.318,
      "endSec": 87.098,
      "text": "All day and all night"
    },
    {
      "startSec": 87.098,
      "endSec": 90.877,
      "text": "Something’s gotta give now"
    },
    {
      "startSec": 90.877,
      "endSec": 94.657,
      "text": "’Cause I’m dying just to know your name"
    },
    {
      "startSec": 94.657,
      "endSec": 98.437,
      "text": "And I need you here with me now"
    },
    {
      "startSec": 98.437,
      "endSec": 102.216,
      "text": "’Cause you’ve got that one thing"
    },
    {
      "startSec": 102.216,
      "endSec": 105.996,
      "text": "So get out, get out, get out of my head"
    },
    {
      "startSec": 105.996,
      "endSec": 109.775,
      "text": "And fall into my arms instead"
    },
    {
      "startSec": 109.775,
      "endSec": 113.555,
      "text": "I don’t, I don’t, don’t know what it is"
    },
    {
      "startSec": 113.555,
      "endSec": 117.334,
      "text": "But I need that one thing"
    },
    {
      "startSec": 117.334,
      "endSec": 121.114,
      "text": "So get out, get out, get out of my mind"
    },
    {
      "startSec": 121.114,
      "endSec": 124.894,
      "text": "And come on, come into my life"
    },
    {
      "startSec": 124.894,
      "endSec": 128.673,
      "text": "I don’t, I don’t, don’t know what it is"
    },
    {
      "startSec": 128.673,
      "endSec": 132.453,
      "text": "But I need that one thing"
    },
    {
      "startSec": 132.453,
      "endSec": 136.232,
      "text": "And you’ve got that one thing"
    },
    {
      "startSec": 136.232,
      "endSec": 143.792,
      "text": "Woah-oh-oh-oh",
      "soft": true
    },
    {
