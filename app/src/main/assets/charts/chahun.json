  "lyrics": [
    {
      "startSec": 0.105,
      "endSec": 35.991,
      "text": "Acoustic Guitar Intro",
      "soft": true
    },
    {
      "startSec": 35.991,
      "endSec": 40.477,
      "text": "Tu hi yeh mujhko bata de"
    },
    {
      "startSec": 40.477,
      "endSec": 44.962,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 44.962,
      "endSec": 49.448,
      "text": "Apne tu dil ka pata de"
    },
    {
      "startSec": 49.448,
      "endSec": 53.934,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 53.934,
      "endSec": 58.42,
      "text": "Tu hi yeh mujhko bata de"
    },
    {
      "startSec": 58.42,
      "endSec": 62.905,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 62.905,
      "endSec": 67.391,
      "text": "Apne tu dil ka pata de"
    },
    {
      "startSec": 67.391,
      "endSec": 71.877,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 71.877,
      "endSec": 76.363,
      "text": "Itna bata doon tujhko, chaahat pe apni mujhko"
    },
    {
      "startSec": 76.363,
      "endSec": 80.848,
      "text": "Yun toh nahi ikhtiyaar"
    },
    {
      "startSec": 80.848,
      "endSec": 85.334,
      "text": "Phir bhi yeh socha dil ne, ab jo laga hoon milne"
    },
    {
      "startSec": 85.334,
      "endSec": 89.82,
      "text": "Poochhu tujhe ek baar o…"
    },
    {
      "startSec": 89.82,
      "endSec": 94.305,
      "text": "Tu hi yeh mujhko bata de"
    },
    {
      "startSec": 94.305,
      "endSec": 98.791,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 98.791,
      "endSec": 103.277,
      "text": "Apne tu dil ka pata de"
    },
    {
      "startSec": 103.277,
      "endSec": 107.763,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 107.763,
      "endSec": 125.706,
      "text": "Guitar Interlude",
      "soft": true
    },
    {
      "startSec": 125.706,
      "endSec": 134.677,
      "text": "Aisi kabhi pehle huyi naa thi khwaahishein"
    },
    {
      "startSec": 134.677,
      "endSec": 143.648,
      "text": "O… kisi se bhi milne ki naa ki thi koshishein"
    },
    {
      "startSec": 143.648,
      "endSec": 148.134,
      "text": "Uljhan meri suljha de"
    },
    {
      "startSec": 148.134,
      "endSec": 152.62,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 152.62,
      "endSec": 157.106,
      "text": "Aankhon aankhon mein jataa de"
    },
    {
      "startSec": 157.106,
      "endSec": 161.591,
      "text": "Chahun main ya naa"
    },
    {
      "startSec": 161.591,
      "endSec": 197.477,
      "text": "Acoustic & Strings Interlude",
      "soft": true
    },
    {
      "startSec": 197.477,
      "endSec": 206.449,
      "text": "Mere chhote chhote khwaab hain, khwabon mein geet hain"
    },
    {
      "startSec": 206.449,
      "endSec": 215.42,
      "text": "Geeton mein zindagi hain, chaahat hain preet hain"
    },
    {
      "startSec": 215.42,
      "endSec": 224.392,
      "text": "Abhi main na dekhoon khwaab woh jin mein na tu mile"
    },
    {
      "startSec": 224.392,
      "endSec": 235.606,
      "text": "Le khole honth maine ab tak the jo sile"
    },
    {
      "startSec": 235.606,
      "endSec": 244.577,
      "text": "Mujhko na jitna mujh pe, utna iss dil ko tujh pe"
    },
    {
      "startSec": 244.577,
      "endSec": 249.063,
      "text": "Hone laga aitbaar"
    },
    {
      "startSec": 249.063,
      "endSec": 258.035,
      "text": "Tanha lamhon mein apne bunti hoon tere sapne"
    },
    {
      "startSec": 258.035,
      "endSec": 264.763,
      "text": "Tujhse hua mujhko pyaar o…"
    },
    {
      "startSec": 264.763,
      "endSec": 269.249,
      "text": "Poochungi tujhko kabhi naa — Chahun main ya naa"
    },
    {
      "startSec": 269.249,
      "endSec": 273.735,
      "text": "Tere khwaabon mein ab jeena — Chahun main kyun naa"
    },
    {
      "startSec": 273.735,
      "endSec": 278.22,
      "text": "Tu hi yeh mujhko bata de — Chahun main ya naa"
    },
    {
      "startSec": 278.22,
      "endSec": 282.706,
      "text": "Apne tu dil ka pata de — Chahun main ya naa"
    },
    {
      "startSec": 282.706,
      "endSec": 300.649,
      "text": "Acoustic Outro",
      "soft": true
    }
  ]
}